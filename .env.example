# Copy to .env to override the defaults.
CERTGEN_DATABASE_URL=sqlite:///./certificates.db
# CERTGEN_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/certificates
CERTGEN_STORAGE_DIR=./storage
CERTGEN_PROCESSING_MODE=background
CERTGEN_WORKER_THREADS=2
CERTGEN_MAX_RECIPIENTS_PER_JOB=5000
